{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "compositor-gpu": ["./compositor-gpu/src/index.ts"],
      "compositor-gpu/fx": ["./compositor-gpu/src/fx/index.ts"],
      "compositor-gpu/react": ["./compositor-gpu/src/react/index.ts"],
      "compositor-gpu/dials": ["./compositor-gpu/src/dials/index.ts"]
    },
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@webgpu/types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules"]
}
